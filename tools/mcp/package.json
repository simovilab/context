{
  "name": "@infotp-studio/mcp",
  "private": true,
  "version": "0.1.0",
  "description": "InfoTP Context MCP Server — read-only agent-facing view of the context store over stdio MCP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "infotp-context-mcp": "dist/index.js"
  },
